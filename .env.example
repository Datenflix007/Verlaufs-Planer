# Local single-user mode is deliberately loopback-only. Never commit a real .env file.
APP_MODE=local
HOST=127.0.0.1
PORT=5173

# Relative paths are resolved from the application directory. Use absolute paths
# for a Raspberry Pi service or another persistent deployment location.
DATABASE_URL=data/verlaufsplaner.sqlite
STORAGE_PATH=data/storage

# Set this when the app is deployed behind HTTPS; a future session adapter uses it
# to enable Secure cookies. Generate a long random value outside the repository.
# BASE_URL=https://verlaufsplaner.example.de
# SESSION_SECRET=
